# ─────────────────────────────────────────────────────────────────────────────
# Cleared — environment
# Copy to .env for local work. Nothing here belongs in version control.
# Run `npm run doctor` to validate: it prints what is missing and whether this
# deployment could actually take money from a customer.
# ─────────────────────────────────────────────────────────────────────────────

# --- Required ---------------------------------------------------------------
# PostgreSQL. Next reads this while collecting page data, so `npm run build`
# fails without it even if you only want static output.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Secrets ----------------------------------------------------------------
# Required in production. They drive AES-256-GCM encryption of passenger
# documents and the HMAC on the trip-access cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# --- Inventory provider -----------------------------------------------------
# duffel_test_…  → sandbox (orders simulated by the provider)
# duffel_live_…  → live airline inventory
# blank          → no inventory. The site refuses to sell UNLESS the switch below
#                  is enabled, so a misconfigured production deploy cannot show a
#                  customer a flight that does not exist.
DUFFEL_ACCESS_TOKEN=

# Explicit opt-in to synthetic inventory outside development (staging, smoke
# tests). NEVER set this in production: it lets invented fares reach customers.
ALLOW_SYNTHETIC_INVENTORY=

# --- Payments ---------------------------------------------------------------
# none | paystack | stripe | mock
#   none    → checkout refuses to take a card (honest default)
#   mock    → full money state machine, no money moves; for tests and demos
#   paystack→ NGN/GHS/ZAR/USD card + transfer + USSD  (needs PAYSTACK_SECRET_KEY)
#   stripe  → global cards                            (needs STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET)
PAYMENTS_PROVIDER=none
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only used when PAYMENTS_PROVIDER=mock.
MOCK_PAY_SECRET=
# Bearer secret for /api/cron/reconcile outside Vercel Cron.
CRON_SECRET=

# --- Email ------------------------------------------------------------------
# none | resend | postmark
#   none → every message is still created and queued, marked `skipped` with the reason
#          "no_email_provider". Nothing is faked: the trip page shows what was not sent.
EMAIL_PROVIDER=none
EMAIL_FROM=Cleared <bookings@yourdomain.com>
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
# Where internal alerts go (paid-but-not-ticketed). Unset = ops mail is skipped.
OPS_EMAIL=

# --- Pricing ----------------------------------------------------------------
# A percentage of the airline amount, floored and capped per paying traveller.
# A flat fee is below supplier cost on any expensive ticket: see
# docs/04-business-analysis.md §4 before changing these.
SERVICE_FEE_PERCENT=2.5
SERVICE_FEE_MIN=6
SERVICE_FEE_MAX=40

# --- Brand and support ------------------------------------------------------
COMPANY_LEGAL_NAME=Cleared Travel Ltd
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Any channel left blank is simply not displayed — no placeholders.
SUPPORT_EMAIL=
SUPPORT_PHONE=
# Digits only, e.g. 2348012345678. Enables the WhatsApp link.
SUPPORT_WHATSAPP=

# --- Development fixtures ---------------------------------------------------
# Set to 1 to make the synthetic provider re-price between search and checkout,
# so the PRICE_CHANGED / FARE_EXPIRED paths can be exercised by hand.
DEMO_SIMULATE_PRICE_CHANGE=

# --- Platform API (the Render service) --------------------------------------
# The web app proxies /api/platform/* to this address server-side so the admin
# session cookie never leaves the same origin. Without it, the desk cannot sign in.
#   local:       http://127.0.0.1:8080
#   production:  https://cleared-api.onrender.com
PLATFORM_API_URL=http://127.0.0.1:8080

# --- First owner account ----------------------------------------------------
# Consumed once by `npm run seed` in apps/api. The password is validated for
# strength and never logged. Change it from the desk after the first sign-in.
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=

# --- Per-traveller flat fee -------------------------------------------------
# Only consulted when SERVICE_FEE_PERCENT is 0 (legacy flat-fee mode).
SERVICE_FEE_PER_TRAVELLER=5
