# ─────────────────────────────────────────────────────────────────────────────
# Cleared platform API (Render). Copy to .env for local work.
# Validate by starting the service: it exits on a bad configuration.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080

# Neon. Pooled host for the app ("...-pooler..."), direct host for migrations.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# 0 disables TLS (local Postgres); 1 forces it. Inferred from the host when unset.
PGSSL=
PGPOOL_MAX=8

# Signs the admin session cookie's trust domain. Separate from the web app's secret.
# Generate: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# The Vercel origin allowed to call this API directly.
WEB_ORIGIN=http://localhost:3000
# Set to 1 in production (HTTPS only). 0 for local http:// work.
COOKIE_SECURE=0

# Cloudinary (media library). Leave blank to disable uploads honestly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cleared

# First-owner bootstrap for `npm run seed`.
SEED_ADMIN_EMAIL=owner@cleared.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Owner
